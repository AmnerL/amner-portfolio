---
/**
 * Projects.astro
 * Projects section in "ledger" format (technical log).
 * No cards, no glow, no heavy hover.
 * Hierarchy is given by the numeric index and information density.
 */
import ProjectCase from "./ProjectCase.astro";

const projects = [
    {
        id: "compliance-hub",
        index: "01",
        title: "Compliance Hub",
        subtitle: "Asistente de Cumplimiento Normativo con IA",
        description:
            "Plataforma empresarial para la gestión de cumplimiento normativo que integra un asistente de IA generativa. El asistente utiliza un pipeline RAG para responder preguntas en lenguaje natural sobre documentos legales, citando las fuentes exactas.",
        pipeline: {
            label: "Pipeline RAG",
            steps: [
                "Ingesta de PDFs → Chunking",
                "Embeddings con Gemini",
                "Almacenamiento vectorial en pgvector",
                "Consulta al LLM → Respuesta con fuentes",
            ],
        },
        contributions: [
            "Backend con Java 21, Spring Boot 3.5 y Spring AI. Arquitectura hexagonal, DDD y principios SOLID.",
            "Pipeline RAG completo: ingesta, chunking, embeddings, pgvector y consulta al LLM.",
            "Frontend con React 19, TypeScript, Redux Toolkit y Tailwind CSS 4.",
            "Spring Security + JWT, gestión documental, checklists, notificaciones, reportes PDF y panel de auditoría.",
        ],
        techs: [
            "Java 21",
            "Spring Boot",
            "Spring AI",
            "Gemini",
            "PostgreSQL",
            "pgvector",
            "React 19",
            "TypeScript",
            "Redux Toolkit",
            "Tailwind 4",
            "Docker",
            "AWS",
        ],
        links: [
            {
                label: "Backend",
                href: "https://github.com/AmnerL/compliance-hub",
            },
            {
                label: "Frontend",
                href: "https://github.com/AmnerL/compliance-hub-front",
            },
        ],
    },
    {
        id: "ezpark",
        index: "02",
        title: "EzPark",
        subtitle: "Plataforma de Estacionamiento P2P",
        description:
            "Plataforma web para conectar conductores con propietarios de cocheras. Lideré el diseño de la arquitectura de microservicios del backend, incluyendo un agente conversacional con IA que permite consultar disponibilidad y ejecutar acciones en lenguaje natural.",
        pipeline: {
            label: "Arquitectura de Microservicios",
            steps: [
                "Usuario → Agente ReAct (Gemini + LangChain4j)",
                "Tool Calling → Ejecuta acciones sobre la BD",
                "Apache Kafka → Comunicación asíncrona",
                "Microservicios → Reservas, pagos, notificaciones",
            ],
        },
        contributions: [
            "Arquitectura completa de microservicios con Java y Spring Boot.",
            "Agente conversacional con IA (Gemini + LangChain4j) usando patrón ReAct y Tool Calling.",
            "Comunicación asíncrona con Apache Kafka para reservas y notificaciones en tiempo real.",
            "Dockerización de cada microservicio y despliegue en AWS EC2 con API Gateway.",
        ],
        techs: [
            "Java",
            "Spring Boot",
            "Apache Kafka",
            "Gemini",
            "LangChain4j",
            "Docker",
            "AWS EC2",
            "PostgreSQL",
        ],
        links: [],
    },
];
---

<section id="projects" class="section-shell" aria-labelledby="projects-title">
    <div class="site-container">
        <header class="section-head" data-reveal>
            <span class="section-kicker">Portafolio</span>
            <h2 id="projects-title" class="section-title">Proyectos</h2>
            <p class="section-subtitle">
                Soluciones reales con arquitectura real. Cada proyecto documenta
                el pipeline completo, las decisiones técnicas y el stack
                utilizado.
            </p>
        </header>

        <div class="project-ledger">
            {
                projects.map((p) => (
                    <ProjectCase
                        id={p.id}
                        index={p.index}
                        title={p.title}
                        subtitle={p.subtitle}
                        description={p.description}
                        pipeline={p.pipeline}
                        contributions={p.contributions}
                        techs={p.techs}
                        links={p.links}
                    />
                ))
            }
        </div>
    </div>
</section>
