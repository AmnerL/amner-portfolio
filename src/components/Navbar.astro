---
/**
 * Navbar.astro
 * Barra de navegación fija con efecto glassmorphism al scroll.
 * Mobile: hamburguesa → overlay fullscreen con animación stagger.
 */
import { Menu, X, Mail, Download } from "@lucide/astro";

const navLinks = [
    { label: "Sobre Mí", href: "#about" },
    { label: "Proyectos", href: "#projects" },
    { label: "Stack", href: "#stack" },
    { label: "Trayectoria", href: "#journey" },
    { label: "Contacto", href: "#contact" },
];
---

<header
    id="navbar"
    class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 ease-in-out"
>
    <nav
        class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 md:px-8"
        aria-label="Navegación principal"
    >
        <!-- Monograma / Logo -->
        <a
            href="#hero"
            class="font-heading text-xl font-bold tracking-tight text-text-primary transition-colors duration-200 hover:text-accent-hover"
            aria-label="Amner Levi — Inicio"
        >
            <span
                class="bg-gradient-to-r from-accent to-info bg-clip-text text-transparent"
            >
                AL
            </span>
        </a>

        <!-- Links desktop -->
        <ul class="hidden items-center gap-8 md:flex">
            {
                navLinks.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            class="text-sm font-medium text-text-secondary transition-colors duration-200 hover:text-text-primary"
                        >
                            {link.label}
                        </a>
                    </li>
                ))
            }

            <!-- CV como link de texto (siempre a 1 clic, sin robar el botón) -->
            <li>
                <a
                    href="/cv.pdf"
                    download
                    class="inline-flex items-center gap-1.5 text-sm font-medium text-text-secondary transition-colors duration-200 hover:text-text-primary"
                >
                    <Download size={15} stroke-width={1.5} aria-hidden="true" />
                    CV
                </a>
            </li>

            <!-- Botón de conversión: Contacto -->
            <li>
                <a
                    href="#contact"
                    class="inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-bg-base transition-all duration-300 hover:bg-accent-hover hover:shadow-[0_0_20px_var(--color-accent-glow)]"
                >
                    <Mail size={16} stroke-width={1.5} aria-hidden="true" />
                    Contacto
                </a>
            </li>
        </ul>

        <!-- Botón hamburguesa (móvil) -->
        <button
            id="menu-toggle"
            class="flex h-10 w-10 items-center justify-center rounded-lg text-text-secondary transition-colors duration-200 hover:bg-bg-raised hover:text-text-primary md:hidden"
            aria-label="Abrir menú de navegación"
            aria-expanded="false"
            aria-controls="mobile-menu"
        >
            <Menu size={22} stroke-width={1.5} aria-hidden="true" />
        </button>
    </nav>

    <!-- Menú móvil overlay -->
    <div
        id="mobile-menu"
        class="fixed inset-0 z-40 flex flex-col items-center justify-center gap-8 bg-bg-elevated/95 backdrop-blur-md transition-all duration-300 ease-in-out md:hidden"
        role="dialog"
        aria-modal="true"
        aria-label="Menú de navegación"
        hidden
    >
        {
            navLinks.map((link, i) => (
                <a
                    href={link.href}
                    class="mobile-menu-link font-heading text-2xl font-semibold text-text-secondary transition-colors duration-200 hover:text-text-primary"
                    style={`transition-delay: ${i * 50}ms`}
                >
                    {link.label}
                </a>
            ))
        }

        <!-- CV (link de texto) -->
        <a
            href="/cv.pdf"
            download
            class="mobile-menu-link inline-flex items-center gap-2 font-heading text-2xl font-semibold text-text-secondary transition-colors duration-200 hover:text-text-primary"
            style={`transition-delay: ${navLinks.length * 50}ms`}
        >
            <Download size={22} stroke-width={1.5} aria-hidden="true" />
            CV
        </a>

        <!-- Botón de conversión: Contacto -->
        <a
            href="#contact"
            class="mt-4 inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 text-base font-semibold text-bg-base transition-all duration-300 hover:bg-accent-hover"
        >
            <Mail size={18} stroke-width={1.5} aria-hidden="true" />
            Contacto
        </a>

        <!-- Botón cerrar -->
        <button
            id="menu-close"
            class="absolute top-5 right-5 flex h-10 w-10 items-center justify-center rounded-lg text-text-secondary transition-colors duration-200 hover:bg-bg-raised hover:text-text-primary"
            aria-label="Cerrar menú de navegación"
        >
            <X size={22} stroke-width={1.5} aria-hidden="true" />
        </button>
    </div>
</header>

<script>
    function initNavbar() {
        const navbar = document.getElementById("navbar");
        const menuToggle = document.getElementById("menu-toggle");
        const menuClose = document.getElementById("menu-close");
        const mobileMenu = document.getElementById("mobile-menu");

        // ── Guard clause: si falta algún elemento, salimos sin hacer nada ──
        // A partir de aquí, TS sabe que ninguno es null (type narrowing).
        if (!navbar || !menuToggle || !menuClose || !mobileMenu) return;

        const mobileLinks = Array.from(mobileMenu.querySelectorAll("a"));

        // ── Navbar: glassmorphism al scroll ──
        const handleScroll = () => {
            if (window.scrollY > 20) {
                navbar.classList.add(
                    "border-b",
                    "border-border-subtle",
                    "bg-bg-base/80",
                    "backdrop-blur-md",
                    "shadow-[0_1px_3px_rgba(0,0,0,0.4)]",
                );
            } else {
                navbar.classList.remove(
                    "border-b",
                    "border-border-subtle",
                    "bg-bg-base/80",
                    "backdrop-blur-md",
                    "shadow-[0_1px_3px_rgba(0,0,0,0.4)]",
                );
            }
        };

        window.addEventListener("scroll", handleScroll, { passive: true });
        handleScroll(); // estado inicial

        // ── Menú móvil: toggle ──
        const openMenu = () => {
            mobileMenu.hidden = false;
            document.body.style.overflow = "hidden";
            menuToggle.setAttribute("aria-expanded", "true");
            setTimeout(() => mobileLinks[0]?.focus(), 100);
        };

        const closeMenu = () => {
            mobileMenu.hidden = true;
            document.body.style.overflow = "";
            menuToggle.setAttribute("aria-expanded", "false");
            menuToggle.focus();
        };

        menuToggle.addEventListener("click", openMenu);
        menuClose.addEventListener("click", closeMenu);
        mobileLinks.forEach((link) =>
            link.addEventListener("click", closeMenu),
        );

        // Cerrar con Escape
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && !mobileMenu.hidden) closeMenu();
        });
    }

    initNavbar();
</script>
