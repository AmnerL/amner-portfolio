---
import { Mail } from "@lucide/astro"; // ← genérico, SÍ existe
import GithubIcon from "./icons/GithubIcon.astro"; // ← marca, inline
import LinkedinIcon from "./icons/LinkedinIcon.astro";

const year = new Date().getFullYear();

const socialLinks = [
    {
        label: "LinkedIn",
        href: "https://linkedin.com/in/amnerls",
        Icon: LinkedinIcon,
    },
    { label: "GitHub", href: "https://github.com/AmnerL", Icon: GithubIcon },
    { label: "Email", href: "mailto:amnerlevi20@gmail.com", Icon: Mail },
];
---

<footer class="border-t border-border-subtle bg-bg-surface">
    <div
        class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-5 py-10 md:flex-row md:justify-between md:px-8"
    >
        <!-- Monograma + copyright -->
        <div class="flex flex-col items-center gap-2 md:flex-row md:gap-3">
            <a
                href="#hero"
                class="font-heading text-lg font-bold tracking-tight"
                aria-label="Amner Levi — Inicio"
            >
                <span
                    class="bg-gradient-to-r from-accent to-info bg-clip-text text-transparent"
                >
                    AL
                </span>
            </a>
            <span class="text-sm text-text-tertiary">
                © {year} Amner Levi Llamo Sánchez · Construido con Astro + 🖤
            </span>
        </div>

        <!-- Enlaces sociales -->
        <nav aria-label="Redes sociales" class="flex items-center gap-3">
            {
                socialLinks.map(({ label, href, Icon }) => (
                    <a
                        href={href}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={label}
                        class="flex h-10 w-10 items-center justify-center rounded-lg border border-border-subtle text-text-secondary transition-all duration-300 hover:-translate-y-0.5 hover:border-border-hover hover:bg-bg-raised hover:text-text-primary"
                    >
                        <Icon size={18} stroke-width={1.5} aria-hidden="true" />
                    </a>
                ))
            }
        </nav>
    </div>
</footer>
