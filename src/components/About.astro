---
/**
 * About.astro
 * "About Me" section: asymmetric layout in a spec-sheet style.
 * - Left: narrative bio (profile-statement)
 * - Right: spec-list with hard data (replaces the 3 generic cards)
 * - No monogram, no glow, no card grid, no staggered animations.
 */
import {
    Server,
    BrainCircuit,
    Landmark,
    GraduationCap,
    Briefcase,
} from "@lucide/astro";
---

<section id="about" class="section-shell" aria-labelledby="about-title">
    <div class="site-container">
        <!-- Section header -->
        <header class="section-head" data-reveal>
            <span class="section-kicker">Perfil</span>
            <h2 id="about-title" class="section-title">Sobre Mí</h2>
            <p class="section-subtitle">
                Ingeniero de Software con enfoque dual: backend de alta
                concurrencia e inteligencia artificial generativa aplicada al
                sector Fintech.
            </p>
        </header>

        <!-- Asymmetric grid: bio + spec list -->
        <div class="profile-grid">
            <!-- Left column: narrative bio -->
            <div data-reveal>
                <p class="profile-statement">
                    Soy un Ingeniero de Software en formación con experiencia
                    comprobada en el ciclo de vida de aplicaciones
                    empresariales. Durante 10 meses como
                    <strong
                        >Desarrollador de Software (Régimen de Formación)</strong
                    >
                    en CIVA, diseñé APIs RESTful, implementé almacenamiento seguro
                    en AWS S3 y desarrollé interfaces de administración con React
                    para usuarios reales del área de Recursos Humanos.
                </p>
                <p class="profile-statement">
                    Mi proyecto personal, <strong>Compliance Hub</strong>, es
                    una plataforma empresarial full-stack con un asistente de IA
                    basado en arquitectura RAG: ingesta de PDFs, generación de
                    embeddings, almacenamiento vectorial en PostgreSQL
                    (pgvector) y consulta con LLMs que responden con fuentes
                    textuales verificables. Busco activamente oportunidades
                    donde pueda contribuir a la transformación digital del
                    sector financiero.
                </p>
            </div>

            <!-- Right column: Spec list (replaces the 3 cards) -->
            <dl class="spec-list" data-reveal>
                <div class="spec-list__row">
                    <dt>
                        <Server size={14} aria-hidden="true" />
                        Backend
                    </dt>
                    <dd>
                        Java 21 · Spring Boot 3.5.x · Microservicios · Kafka
                    </dd>
                </div>
                <div class="spec-list__row">
                    <dt>
                        <BrainCircuit size={14} aria-hidden="true" />
                        IA Generativa
                    </dt>
                    <dd>
                        RAG · LangChain4j · LLMs (Gemini, watsonx) · Embeddings
                    </dd>
                </div>
                <div class="spec-list__row">
                    <dt>
                        <Landmark size={14} aria-hidden="true" />
                        Sector
                    </dt>
                    <dd>Fintech · Compliance · Automatización normativa</dd>
                </div>
                <div class="spec-list__row">
                    <dt>
                        <Briefcase size={14} aria-hidden="true" />
                        Experiencia
                    </dt>
                    <dd>
                        Desarrollador de Software en CIVA · 10 meses · Java /
                        TypeScript / React
                    </dd>
                </div>
                <div class="spec-list__row">
                    <dt>
                        <GraduationCap size={14} aria-hidden="true" />
                        Educación
                    </dt>
                    <dd>UPC · Ingeniería de Software · 2022 – 2027</dd>
                </div>
            </dl>
        </div>
    </div>
</section>
