---
/**
 * Journey.astro
 * Timeline in "journey-list" format (typographic log).
 * Layout: date/meta on the left, content on the right.
 * No vertical timeline, no nodes, no cards, no glow, no hover.
 * The information speaks for itself.
 */
import { Trophy, BadgeCheck } from "@lucide/astro";

interface CertItem {
    name: string;
    issuer: string;
    date: string;
}
interface LangItem {
    lang: string;
    level: string;
    note?: string;
}

interface Milestone {
    title: string;
    org: string;
    period: string;
    achievement?: string;
    summary?: string;
    certs?: CertItem[];
    langs?: LangItem[];
}

const milestones: Milestone[] = [
    {
        title: "Ingeniería de Software",
        org: "Universidad Peruana de Ciencias Aplicadas (UPC)",
        period: "2022 – 2027",
        achievement:
            "Quinto superior · Promedio acumulado 17.71 · Décimo superior en varios ciclos.",
    },
    {
        title: "Trainee de Desarrollo",
        org: "CIVA · Lima, Perú",
        period: "Dic 2024 – Sep 2025",
        summary:
            "Desarrollo de funcionalidades clave para un sistema de Gestión de Capital Humano (HCM) en entorno Java/TypeScript. Diseño de APIs RESTful, implementación de almacenamiento en AWS S3, generación de PDFs con Thymeleaf y desarrollo de interfaces de administración con React para usuarios reales del área de RRHH.",
    },
    {
        title: "Certificaciones",
        org: "Formación continua validada",
        period: "2023 – 2025",
        certs: [
            {
                name: "Generative AI Fundamentals Specialization",
                issuer: "IBM",
                date: "Oct 2025",
            },
            {
                name: "Databases for Data Scientists Specialization",
                issuer: "University of Colorado Boulder",
                date: "Nov 2025",
            },
            {
                name: "Scrum Fundamentals",
                issuer: "SCRUMstudy",
                date: "May 2023",
            },
            {
                name: "Cybersecurity: Digital Dark Arts Defense",
                issuer: "Coursera",
                date: "Abr 2023",
            },
        ],
    },
    {
        title: "Idiomas",
        org: "Comunicación técnica y profesional",
        period: "",
        langs: [
            { lang: "Español", level: "Nativo" },
            {
                lang: "Inglés",
                level: "Técnico fluido",
                note: "Lectura fluida de documentación, RFCs y código. Comunicación oral en desarrollo activo.",
            },
        ],
    },
];
---

<section id="journey" class="section-shell" aria-labelledby="journey-title">
    <div class="site-container">
        <header class="section-head" data-reveal>
            <span class="section-kicker">Trayectoria</span>
            <h2 id="journey-title" class="section-title">
                Formación & Experiencia
            </h2>
            <p class="section-subtitle">
                Educación, experiencia profesional y validación externa de
                competencias técnicas.
            </p>
        </header>

        <div class="journey-list">
            {
                milestones.map((item) => (
                    <div class="journey-entry">
                        {/* Left column: Meta / Date */}
                        <div>
                            <span class="journey-entry__meta">
                                {item.period}
                            </span>
                        </div>

                        {/* Right column: Content */}
                        <div>
                            <h3>{item.title}</h3>
                            <p class="journey-entry__meta">{item.org}</p>

                            {/* Education: achievement */}
                            {item.achievement && (
                                <p class="mt-3 flex items-start gap-2 text-sm leading-relaxed text-[var(--color-ink-soft)]">
                                    <Trophy
                                        size={15}
                                        stroke-width={1.5}
                                        class="mt-0.5 shrink-0 text-[var(--color-success)]"
                                        aria-hidden="true"
                                    />
                                    <span>{item.achievement}</span>
                                </p>
                            )}

                            {/* Experience: summary */}
                            {item.summary && (
                                <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)]">
                                    {item.summary}
                                </p>
                            )}

                            {/* Certifications */}
                            {item.certs && (
                                <ul class="journey-entry__details">
                                    {item.certs.map((c) => (
                                        <li class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                                            <span class="flex items-start gap-2 text-sm">
                                                <BadgeCheck
                                                    size={15}
                                                    stroke-width={1.5}
                                                    class="mt-0.5 shrink-0 text-[var(--color-accent)]"
                                                    aria-hidden="true"
                                                />
                                                <span>
                                                    <span class="font-medium text-[var(--color-ink)]">
                                                        {c.name}
                                                    </span>
                                                    <span class="text-[var(--color-muted)]">
                                                        {" "}
                                                        · {c.issuer}
                                                    </span>
                                                </span>
                                            </span>
                                            <span class="text-xs text-[var(--color-muted)]">
                                                {c.date}
                                            </span>
                                        </li>
                                    ))}
                                </ul>
                            )}

                            {/* Languages */}
                            {item.langs && (
                                <ul class="journey-entry__details">
                                    {item.langs.map((l) => (
                                        <li class="flex flex-wrap items-center gap-x-3 gap-y-1">
                                            <span class="text-sm font-medium text-[var(--color-ink)]">
                                                {l.lang}
                                            </span>
                                            <span class="rounded-[var(--radius-control)] border border-[var(--color-rule-strong)] px-2 py-0.5 text-xs font-medium text-[var(--color-accent)]">
                                                {l.level}
                                            </span>
                                            {l.note && (
                                                <span class="w-full text-xs leading-relaxed text-[var(--color-muted)]">
                                                    {l.note}
                                                </span>
                                            )}
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
