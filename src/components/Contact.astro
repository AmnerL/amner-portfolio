---
import { ArrowUpRight, Copy } from "@lucide/astro";
const email = "amnerlevi20@gmail.com";
---
<section id="contact" class="contact section" aria-labelledby="contact-title">
  <div class="container contact-layout">
    <div class="contact-intro">
      <h2 id="contact-title">Hablemos</h2>
      <p class="lead">Oportunidades laborales y proyectos freelance.</p>
      <p>Si necesitas desarrollar un backend con Java y Spring Boot o integrar IA en una aplicación, puedes escribirme.</p>
    </div>
    <div class="contact-body">
      <div class="email-row">
        <a class="email text-link" href={`mailto:${email}`}>{email}<ArrowUpRight size={22} aria-hidden="true" /></a>
        <button class="button copy-button" id="copy-email" type="button" hidden><Copy size={16} aria-hidden="true" /> Copiar correo</button>
      </div>
      <p id="copy-status" role="status" aria-live="polite"></p>
      <div class="channels">
        <a class="text-link" href="https://linkedin.com/in/amnerls" target="_blank" rel="noopener noreferrer">LinkedIn <ArrowUpRight size={18} aria-hidden="true" /><span class="sr-only"> (abre otra pestaña)</span></a>
        <a class="text-link" href="https://github.com/AmnerL" target="_blank" rel="noopener noreferrer">GitHub <ArrowUpRight size={18} aria-hidden="true" /><span class="sr-only"> (abre otra pestaña)</span></a>
      </div>
    </div>
  </div>
</section>
<script>
const button = document.querySelector<HTMLButtonElement>("#copy-email");
const status = document.querySelector<HTMLElement>("#copy-status");
if(button && status) { button.hidden = false; button.addEventListener("click", async () => {button.disabled = true; try {if(!navigator.clipboard?.writeText) throw new Error("Clipboard unavailable"); await navigator.clipboard.writeText("amnerlevi20@gmail.com"); status.textContent = "Correo copiado."; } catch {status.textContent = "No se pudo copiar. Selecciona el correo para copiarlo manualmente o pulsa el enlace para escribir."; } finally {button.disabled = false;} });}
</script>
