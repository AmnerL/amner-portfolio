---
/**
 * SectionHeading.astro
 * Encabezado reutilizable: barra de acento + H2 + subtítulo opcional.
 * El `id` va en el <h2> para aria-labelledby; el ancla (#about) va en la <section>.
 */
interface Props {
    id: string;
    title: string;
    subtitle?: string;
    align?: "left" | "center";
}

const { id, title, subtitle, align = "left" } = Astro.props;
const isCenter = align === "center";
---

<div class={isCenter ? "flex flex-col items-center text-center" : ""}>
    <div class="flex items-center gap-3">
        <!-- Barra de acento (motivo de marca) -->
        <span
            class="h-7 w-1 shrink-0 rounded-full bg-gradient-to-b from-accent to-info"
            aria-hidden="true"></span>
        <h2
            id={id}
            class="font-heading text-[1.75rem] font-semibold leading-tight tracking-tight text-text-primary md:text-[2rem] lg:text-[2.25rem]"
        >
            {title}
        </h2>
    </div>

    {
        subtitle && (
            <p
                class:list={[
                    "mt-3 max-w-2xl text-base leading-relaxed text-text-secondary",
                    isCenter ? "" : "ml-4", // compensa barra(4px) + gap(12px) = 16px
                ]}
            >
                {subtitle}
            </p>
        )
    }
</div>
