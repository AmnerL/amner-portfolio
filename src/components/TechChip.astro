---
/**
 * TechChip.astro
 * Chip de tecnología con logo oficial (color de marca) + label.
 * - Logo vía simple-icons (build-time). aria-hidden (el label ya nombra la tech).
 * - Si no hay logo (noIcon o slug no hallado) → punto de color (fallback elegante).
 * - El label cumple el contraste; el logo es decorativo → no depende de WCAG 1.4.11.
 */
import { getTechMeta } from "../data/tech";

interface Props {
    label: string;
    slugs?: string | string[]; // candidato(s) de simple-icons
    noIcon?: boolean; // fuerza el punto de color (conceptos: RAG, DDD…)
    dotColor?: string; // color del punto si no hay logo (default: accent)
}

const { label, slugs, noIcon = false, dotColor } = Astro.props;
const meta = noIcon ? null : getTechMeta(slugs);
const dot = dotColor ?? meta?.hex ?? "var(--color-accent)";
---

<li
    class="group inline-flex items-center gap-2 rounded-md border border-border-subtle bg-bg-raised px-3 py-1.5 text-[0.8rem] font-medium text-text-secondary transition-all duration-300 ease-in-out hover:-translate-y-0.5 hover:border-border-hover hover:text-text-primary"
>
    {
        meta ? (
            <svg
                viewBox="0 0 24 24"
                width="15"
                height="15"
                fill={meta.hex}
                class="shrink-0 transition-transform duration-300 group-hover:scale-110"
                aria-hidden="true"
            >
                <path d={meta.path} />
            </svg>
        ) : (
            <span
                class="h-2.5 w-2.5 shrink-0 rounded-full"
                style={`background-color: ${dot}`}
                aria-hidden="true"
            />
        )
    }
    <span class="whitespace-nowrap">{label}</span>
</li>
