---
const groups = [
  { title: "Backend y datos", entries: [
    { tech: "Java · Spring Boot · Spring Data JPA · Hibernate", context: "Experiencia profesional y proyectos" },
    { tech: "PostgreSQL · SQL · APIs REST · JPA Criteria API", context: "Experiencia profesional" },
    { tech: "Spring Security · JWT", context: "Proyecto personal" }
  ]},
  { title: "Frontend", entries: [
    { tech: "React · TypeScript · JavaScript", context: "Experiencia profesional y proyecto personal" },
    { tech: "Redux Toolkit · Material UI", context: "Experiencia profesional" }
  ]},
  { title: "IA aplicada", entries: [
    { tech: "Spring AI · Gemini · RAG · Embeddings · pgvector", context: "Proyecto personal" },
    { tech: "LangChain4j · Tool Calling", context: "Práctica académica" },
    { tech: "Python · pandas · scikit-learn · Streamlit", context: "Investigación académica en desarrollo" }
  ]},
  { title: "Herramientas e infraestructura", entries: [
    { tech: "JUnit · Mockito · Git · AWS S3 · Thymeleaf (generación de documentos PDF)", context: "Experiencia profesional" },
    { tech: "Spring Cloud · Kafka · Docker · AWS EC2", context: "Práctica académica" }
  ]}
];
---
<section id="stack" class="container section" aria-labelledby="stack-title">
  <h2 id="stack-title">Tecnologías</h2>
  <div class="technology-grid">
    {groups.map(group => (
      <div class="technology-group">
        <h3>{group.title}</h3>
        <ul>
          {group.entries.map(entry => (
            <li><span>{entry.tech}</span><small>{entry.context}</small></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
