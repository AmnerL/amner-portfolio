---
/**
 * Stack.astro
 * Tech stack in "sheet" format (specification sheet).
 * Layout: rows with category on the left, tags on the right.
 * No cards, no hover, no glow, no simple-icons icons.
 * Typography, borders and information density only.
 */
import {
  Server,
  BrainCircuit,
  MonitorSmartphone,
  Database,
  Cloud,
  Wrench,
} from "@lucide/astro";

const categories = [
  {
    Icon: Server,
    title: "Backend & Arquitectura",
    techs: [
      "Java 17 / 21",
      "Spring Boot 3.2",
      "Spring Cloud",
      "Spring Security",
      "JPA / Hibernate",
      "Apache Kafka",
      "API Gateway",
      "Maven",
      "Microservicios",
      "Arq. Hexagonal",
      "DDD",
      "Node.js",
    ],
  },
  {
    Icon: BrainCircuit,
    title: "IA Generativa",
    techs: [
      "Spring AI",
      "LangChain4j",
      "RAG",
      "Gemini",
      "IBM watsonx",
      "Hugging Face",
      "Prompt Engineering",
      "Agentes ReAct",
      "Tool Calling",
      "Embeddings",
    ],
  },
  {
    Icon: Database,
    title: "Bases de Datos",
    techs: [
      "PostgreSQL",
      "pgvector",
      "Oracle · PL/SQL",
      "SQL Server",
      "MySQL",
      "MongoDB",
      "Data Warehouse",
    ],
  },
  {
    Icon: Cloud,
    title: "Cloud & DevOps",
    techs: [
      "AWS · EC2 · S3",
      "Docker",
      "Git · GitHub",
      "Linux · Red Hat",
      "Jenkins · CI/CD",
      "JUnit 5",
      "Mockito",
      "Postman",
    ],
  },
  {
    Icon: MonitorSmartphone,
    title: "Frontend",
    techs: [
      "React 19",
      "TypeScript",
      "Redux Toolkit",
      "Tailwind CSS 4",
      "Angular 11+",
      "Astro",
      "Vite",
    ],
  },
  {
    Icon: Wrench,
    title: "Herramientas & Métodos",
    techs: [
      "Scrum",
      "Jira",
      "Swagger / OpenAPI",
      "Thymeleaf",
      "Bitbucket",
      "Trello",
    ],
  },
];
---

<section
  id="stack"
  class="section-shell section-shell--raised"
  aria-labelledby="stack-title"
>
  <div class="site-container">
    <header class="section-head" data-reveal>
      <span class="section-kicker">Tecnologías</span>
      <h2 id="stack-title" class="section-title">Stack Técnico</h2>
      <p class="section-subtitle">
        Herramientas con las que construyo sistemas distribuidos, pipelines de
        IA y aplicaciones empresariales de alta concurrencia.
      </p>
    </header>

    <div class="stack-sheet">
      {
        categories.map(({ Icon, title, techs }) => (
          <div class="stack-row">
            <div class="stack-row__head">
              <Icon
                size={18}
                stroke-width={1.5}
                class="stack-row__icon"
                aria-hidden="true"
              />
              <span>{title}</span>
            </div>
            <ul class="tech-list">
              {techs.map((t) => (
                <li class="tech-tag">{t}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
