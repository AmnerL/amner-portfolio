---
import { ArrowDown, Download, ArrowUpRight, BadgeCheck } from "@lucide/astro";
import SoftwareLayers from "./SoftwareLayers.astro";
---
<section id="hero" class="hero container" aria-labelledby="hero-title">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="hero-name" data-hero-text>Amner Levi Llamo Sánchez</p>
      <h1 id="hero-title" data-hero-text>Ingeniero<br />de Software<span class="hero-period">.</span></h1>
      <p class="hero-description" data-hero-text>Desarrollo aplicaciones con <strong>Java y Spring Boot.</strong> Tengo experiencia en sistemas de recursos humanos y construyo proyectos que integran IA para consultar información documental.</p>
      <div class="actions" data-hero-text>
        <a class="button primary" href="#projects">Ver proyectos <ArrowDown size={18} aria-hidden="true" /></a>
        <a class="button" href="/CV_Amner_Backend_Java.pdf" download>Descargar CV <Download size={18} aria-hidden="true" /></a>
        <a class="text-link" href="#contact">Contacto <ArrowUpRight size={18} aria-hidden="true" /></a>
      </div>
      <div class="hero-credentials" data-hero-text>
        <a href="#journey" class="credential-link"><BadgeCheck size={18} aria-hidden="true" /> AWS Certified AI Practitioner</a>
        <p>Estudiante de Ingeniería de Software · UPC<br />Lima, Perú</p>
      </div>
    </div>
    <SoftwareLayers />
  </div>
  <a class="hero-feature" href="#compliance-hub">
    <span>Proyecto personal · Java + IA</span>
    <strong>Compliance Hub</strong>
    <span>Explorar el proyecto <ArrowUpRight size={18} aria-hidden="true" /></span>
  </a>
</section>
<script>
  import "../scripts/hero-motion";
</script>
