---
/**
 * BaseLayout.astro
 * Root layout: <html>, <head>, fonts, navbar and footer.
 * All pages are wrapped in this layout.
 */
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Amner Levi Llamo Sánchez | Ingeniero de Software",
    description = "Ingeniero de Software con enfoque en backend Java y Spring Boot, experiencia en sistemas de recursos humanos e IA aplicada a consultas documentales. Estudiante de Ingeniería de Software en UPC, con interés en Fintech.",
} = Astro.props;

const SITE_URL = "https://amner-portfolio.vercel.app";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="author" content="Amner Levi Llamo Sánchez" />

        <!-- Open Graph -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={SITE_URL} />
        <meta property="og:image" content={`${SITE_URL}/og.png`} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
            property="og:image:alt"
            content="Amner Levi Llamo Sánchez · Ingeniero de Software · Java, Spring Boot e IA aplicada. Ilustración de las capas de datos, lógica de negocio y API sobre fondo negro con detalles ámbar."
        />

        <!-- Twitter / X: tarjeta con imagen grande -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={`${SITE_URL}/og.png`} />
        <meta name="twitter:image:alt" content="Amner Levi Llamo Sánchez · Ingeniero de Software · Java, Spring Boot e IA aplicada. Tres capas de software en negro y ámbar." />

        <!-- Favicon (AL monogram) -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <title>{title}</title>
    </head>

    <body class="site-shell antialiased">
        <!-- Skip link for keyboard accessibility -->
        <a
            href="#main-content"
            class="skip-link"
        >
            Saltar al contenido principal
        </a>

        <Navbar />

        <main id="main-content">
            <slot />
        </main>

        <Footer />
    </body>
</html>
